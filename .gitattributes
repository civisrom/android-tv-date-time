# Windows launcher scripts must always have CRLF line endings:
# cmd.exe parsing of multi-line blocks is unreliable with LF-only files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper: gradlew обязан остаться с LF, иначе на Windows-чекауте
# он не запустится; jar не должен трогаться нормализацией переводов строк
gradlew text eol=lf
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
