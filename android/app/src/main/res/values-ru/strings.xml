    <string name="app_name">Android TV Time Fixer</string>

    <!-- Режимы работы -->
    <string name="mode_television">Запущено на телевизоре: подключение к этому же устройству.</string>
    <string name="mode_handheld">Запущено на телефоне: подключение к телевизору по сети.</string>

    <!-- Подключение -->
    <string name="connect_title">Подключение к устройству</string>
    <string name="connect_address_hint">IP-адрес или IP:порт</string>
    <string name="connect_action">Подключиться</string>
    <string name="connect_disconnect">Отключиться</string>
    <string name="connect_state_connecting">Подключение к %1$s…</string>
    <string name="connect_state_connected">Подключено к %1$s</string>
    <string name="connect_state_disconnected">Нет подключения</string>
    <string name="connect_try_loopback">Подключиться к этому устройству</string>

    <!-- Причины неудачного подключения -->
    <string name="error_invalid_address">Неверный адрес. Используйте 192.168.1.20 или 192.168.1.20:37105.</string>
    <string name="error_unreachable">Не удаётся достучаться до устройства. Проверьте, что оно в той же сети и отладка включена.</string>
    <string name="error_pairing_required">Устройство требует спаривания по коду. Откройте на нём «Беспроводную отладку» и воспользуйтесь спариванием ниже.</string>
    <string name="error_not_authorized">Подтвердите запрос отладки на экране устройства и повторите попытку.</string>
    <string name="error_pairing_rejected">Устройство отвергло код спаривания. Коды быстро истекают — откройте новый.</string>
    <string name="error_pairing_timeout">Время ожидания спаривания истекло. Проверьте сеть и получите новый код.</string>
    <string name="error_pairing_failed">Не удалось завершить спаривание. Проверьте порт спаривания и получите новый код на телевизоре.</string>
    <string name="error_tls_failed">Не удалось установить защищённое соединение. Проверьте порт отладки и повторите попытку.</string>
    <string name="error_wireless_unsupported">Для спаривания нужен Android 10 или новее на устройстве с этим приложением. Классическая отладка по сети остаётся доступной.</string>
    <string name="error_unknown">Подключение не удалось по неожиданной причине.</string>

    <!-- Спаривание -->
    <string name="pairing_title">Спаривание устройства</string>
    <string name="pairing_hint">На телевизоре откройте «Для разработчиков» → «Беспроводная отладка» → «Подключение с помощью кода».</string>
    <string name="pairing_address_hint">Адрес спаривания, например 192.168.1.20:41234</string>
    <string name="pairing_code_hint">6-значный код</string>
    <string name="pairing_connect_address_hint">Адрес подключения (другой порт)</string>
    <string name="pairing_port_warning">Порт спаривания и порт подключения — разные. Оба показаны на экране телевизора.</string>
    <string name="pairing_action">Спарить и подключиться</string>

