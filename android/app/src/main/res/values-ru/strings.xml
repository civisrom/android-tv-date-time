    <string name="discovery_grant_permission">Разрешить</string>

    <!-- Сервер времени -->
    <string name="ntp_title">Сервер времени</string>
    <string name="ntp_current">Текущий: %1$s</string>
    <string name="ntp_current_unset">Сервер времени не задан</string>
    <string name="ntp_by_country">Ищите по коду страны, названию или адресу — например ru, by, kz. Регистр не важен. Нажатие на найденную строку подставит адрес в поле ниже.</string>
    <string name="ntp_custom_hint">Адрес сервера времени</string>
    <string name="ntp_address_note">Можно ввести доменное имя (time.google.com) или IP-адрес (216.239.35.0) — годится и то, и другое.</string>
    <string name="ntp_scan_entry_ip">IP: %1$s — нажмите, чтобы задать адресом вместо имени</string>
    <string name="ntp_apply">Применить</string>
    <string name="ntp_search_country">Поиск страны</string>
